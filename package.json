{
  "name": "sdkck",
  "description": "Agentic CLI that provides multiple tools via plugins",
  "version": "0.7.1",
  "author": "Hesed",
  "bin": {
    "sdkck": "./bin/run.js"
  },
  "bugs": "https://github.com/hesedcasa/sdkck/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-commands": "^4.1.40",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-not-found": "^3.2.74",
    "@oclif/plugin-plugins": "^5.4.56",
    "@oclif/plugin-update": "^4.7.19",
    "@oclif/plugin-version": "^2.2.36",
    "@scalar/openapi-parser": "^0.25.6",
    "@scalar/postman-to-openapi": "^0.5.3",
    "@scalar/types": "^0.7.4",
    "js-yaml": "^4.1.1",
    "openai": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^5",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10",
    "@types/node": "^25",
    "chai": "^6",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "^3.10.1",
    "mocha": "^11",
    "oclif": "^4",
    "prettier": "^3.8.1",
    "shx": "^0.4.0",
    "ts-node": "^10",
    "ts-prune": "^0.10.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/hesedcasa/sdkck",
  "keywords": [
    "sidekick",
    "cli",
    "ai",
    "agent",
    "llm"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "sdkck",
    "dirname": "sdkck",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-*"
    ],
    "jitPlugins": {
      "@hesed/jira": "^0.2.0",
      "@hesed/conni": "^0.2.0",
      "@hesed/bb": "^0.2.0",
      "@hesed/sentry": "^0.2.0",
      "@hesed/mysql": "^0.2.0",
      "@hesed/psql": "^0.2.0",
      "@hesed/supabase": "^0.2.0"
    },
    "topicSeparator": " ",
    "topics": {},
    "update": {
      "autoupdate": {
        "debounce": 7
      }
    },
    "hooks": {
      "init": [
        "./dist/hooks/init/register-openapi-commands",
        "./dist/hooks/init/apply-permission"
      ],
      "jit_plugin_not_installed": "./dist/hooks/jit_plugin_not_installed/jit-install",
      "prerun": "./dist/hooks/prerun/check-permission"
    }
  },
  "repository": "hesedcasa/sdkck",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "find-deadcode": "ts-prune --ignore '(run|default)'",
    "format": "eslint --cache --fix --quiet . && prettier --write --cache .",
    "pre-commit": "npm run format && npm run find-deadcode"
  },
  "types": "dist/index.d.ts"
}
